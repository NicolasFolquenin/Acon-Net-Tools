# Binários e builds
build/bin/
**/build/bin/
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Permite o instalador oficial do client para distribuição no servidor web
!central-server/public/downloads/*.exe
!central-server/public/downloads/**/*.exe

# Bancos de dados locais
*.db
*.db-journal
data/
mongo_data/*
!mongo_data/.gitkeep
**/mongo_data/*
!**/mongo_data/.gitkeep

# Logs
*.log

# Dependências e caches de ambiente
node_modules/
.vscode/
.idea/

# Arquivos com segredos (variáveis reais de ambiente)
.env

# Perfis dinâmicos de runtime e caches
profile_*.json
measurement_profile.json
**/config/machines/*.json
