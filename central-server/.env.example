# ==============================================================================
# EXEMPLO DE CONFIGURAÇÕES DO SERVIDOR CENTRAL DE TELEMETRIA (.env.example)
# Copie este arquivo para .env e ajuste os valores conforme o seu ambiente.
# Nenhum dado confidencial, IP ou domínio interno deve ser exposto aqui.
# ==============================================================================

# Porta TCP onde o servidor HTTP responderá
PORT=8085

# URL pública ou IP do servidor (usado nos comandos de instalação das sondas e downloads)
# Exemplo: https://nettools.acon.uepg.br ou http://177.101.22.40:8085
PUBLIC_SERVER_URL=https://nettools.acon.uepg.br

# Configurações do Banco de Dados MongoDB
MONGO_URI=mongodb://mongo:27017
MONGO_DB=network_central
MONGO_COLLECTION=metrics

# Token Bearer exigido para ingestão de telemetria das sondas (altere em produção)
API_TOKEN=super-secret-probe-token-2026

# Diretório dos arquivos estáticos do Dashboard Web
STATIC_DIR=/app/public

# Limite padrão de horas para consultas de histórico no Dashboard
QUERY_HOURS_LIMIT=24

# ==============================================================================
# ALVOS DE MEDIÇÃO, REDE E DNS (PARAMETRIZÁVEIS)
# Configure com o IP e domínio da sua própria instituição/empresa
# ==============================================================================
# IP do servidor DNS principal para testes e benchmark das sondas
# (Exemplos públicos seguros: 1.1.1.1, 8.8.8.8, 9.9.9.9 ou o IP do seu DNS interno)
DNS_SERVER_TARGET=1.1.1.1

# Domínio a ser resolvido no teste de DNS (ex: google.com, suaempresa.com.br)
DNS_DOMAIN_TARGET=google.com

# Nome legível do teste DNS exibido no Dashboard e relatórios
DNS_SERVER_NAME=DNS Primário

# Alvo para medição de latência do Core/Roteador Central (IP ou Hostname)
PING_CORE_TARGET=1.1.1.1
PING_CORE_NAME=Roteador Central (Core)

# Alvo padrão de Ping local das máquinas ('auto_gateway' detecta o gateway padrão de cada máquina)
DEFAULT_PING_TARGET=auto_gateway

# Tamanhos padrão para os testes periódicos de throughput das sondas (em Megabytes)
SPEEDTEST_DOWNLOAD_MB=5
SPEEDTEST_UPLOAD_MB=2

# ==============================================================================
# AUTENTICAÇÃO DO DASHBOARD WEB (ALTERE EM PRODUÇÃO)
# ==============================================================================
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=admin123
AUTH_VIEWER_USER=operador
AUTH_VIEWER_PASSWORD=operador123
SESSION_SECRET=super-secret-session-key-change-in-prod-2026

# ==============================================================================
# AUTENTICAÇÃO INSTITUCIONAL SSO (OpenID Connect / Keycloak) [OPCIONAL]
# ==============================================================================
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://sso.suaempresa.com.br/realms/instituicao
OIDC_CLIENT_ID=net-tools
OIDC_CLIENT_SECRET=sua-chave-secreta-do-client-keycloak
OIDC_REDIRECT_URL=https://net-tools.suaempresa.com.br/api/v1/auth/oidc/callback
OIDC_ADMIN_GROUP=noc-admins
