#!/usr/bin/env bash
# ==============================================================================
# UEPG Net Tools - Monitor de Telemetria e Ondas WiFi em Tempo Real
# Permite reabrir a animação a qualquer momento no terminal via:
#   uepg-probe-monitor   ou   uepg-monitor
# ==============================================================================

# Cores para terminal
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# Carrega configurações salvas ou padrões
CONFIG_FILE="/etc/uepg-probe/config.json"
SERVER_URL=""
if [ -f "$CONFIG_FILE" ]; then
  SERVER_URL=$(grep -o '"server_url":[[:space:]]*"[^"]*"' "$CONFIG_FILE" 2>/dev/null | cut -d'"' -f4 || true)
fi
if [ -z "$SERVER_URL" ]; then
  SERVER_URL="https://akvorado.acon.dev.uepg.br"
fi

HOSTNAME=$(cat /etc/hostname 2>/dev/null || uname -n)

# Detecção robusta do IP local da máquina
LOCAL_IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{print $7}' | tr -d '\n')
if [ -z "$LOCAL_IP" ]; then
  LOCAL_IP=$(ip -4 addr show up scope global 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1)
fi
if [ -z "$LOCAL_IP" ]; then
  LOCAL_IP=$(hostname -I 2>/dev/null | awk '{print $1}')
fi
[ -z "$LOCAL_IP" ] && LOCAL_IP="127.0.0.1"

# Detecção robusta do Gateway padrão
GATEWAY_IP=$(ip route show default 2>/dev/null | awk '/default/ {print $3}' | head -n1)
if [ -z "$GATEWAY_IP" ]; then
  GATEWAY_IP=$(ip route 2>/dev/null | awk '/default/ {print $3}' | head -n1)
fi
[ -z "$GATEWAY_IP" ] && GATEWAY_IP="Automático"

# Trap para interceptar o Ctrl+C e restaurar o terminal perfeitamente
cleanup() {
  printf "\033[?25h\033[?1049l"
  echo -e "\n${GREEN}==================================================================${NC}"
  echo -e "${GREEN}  ✓ Monitor fechado! A sonda continua em SEGUNDO PLANO (systemd).${NC}"
  echo -e "${GREEN}==================================================================${NC}"
  echo -e "A sonda UEPG Net Tools permanece coletando telemetria 24/7."
  echo -e "Comandos rápidos úteis:"
  echo -e "  • Reabrir esta animação: ${YELLOW}uepg-probe-monitor${NC} (ou ${YELLOW}uepg-monitor${NC})"
  echo -e "  • Logs em tempo real:    ${YELLOW}journalctl -u uepg-probe -f${NC}"
  echo -e "  • Consultar status:      ${YELLOW}systemctl status uepg-probe${NC}"
  echo -e "  • Executar teste avulso: ${YELLOW}/usr/local/bin/uepg-probe -once${NC}\n"
  exit 0
}
trap cleanup SIGINT SIGTERM

