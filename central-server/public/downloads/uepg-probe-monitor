frame_idx=0
num_frames=16
signals=("[ ▂   ]" "[ ▂▄  ]" "[ ▂▄▆ ]" "[ ▂▄▆█]")

while true; do
  sig="${signals[$(( (frame_idx / 2) % 4 ))]}"
  mm=$(( sec / 60 ))
  ss=$(( sec % 60 ))
  time_str=$(printf "%02d:%02d" $mm $ss)

  eval "cur_f=(\"\${F_${frame_idx}[@]}\")"

  if systemctl is-active --quiet uepg-probe 2>/dev/null; then
    status_badge="${GREEN}● STATUS: ONLINE${NC}  ${BLUE}[ Systemd Daemon ]${NC}"
  else
    status_badge="${RED}○ STATUS: PARADO${NC}  ${YELLOW}[ systemctl start uepg-probe ]${NC}"
