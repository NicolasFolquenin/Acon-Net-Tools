# ==============================================================================
# CONFIGURAÇÕES DA SONDA CLIENT (CLIENT-PROBE) (.env.example)
# ==============================================================================

# Identificação da Localização física
PROBE_LOCATION=Bloco-Central

# URL de conexão com o Servidor Central de Telemetria
PROBE_SERVER_URL=http://localhost:8085

# Token de autenticação Bearer (deve ser idêntico ao API_TOKEN do Servidor Central)
PROBE_API_TOKEN=super-secret-probe-token-2026

# Intervalo padrão de execução das medições (em minutos)
PROBE_INTERVAL_MINUTES=30

# Alvo de Ping padrão ('auto_gateway' detecta o gateway padrão local automaticamente)
PROBE_PING_TARGET=auto_gateway

# Alvos locais de fallback quando desconectado do servidor central
PROBE_DNS_SERVER=1.1.1.1
PROBE_DNS_DOMAIN=google.com
